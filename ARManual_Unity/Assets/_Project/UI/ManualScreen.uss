/* Layout A, colours from docs/mockups/app-flow.html.
   Sizes in px for a 1080 x 1920 reference screen (Panel Settings: Scale With Screen Size). */

.root {
    flex-grow: 1;
    justify-content: space-between;
}

.hidden { display: none; }
.invisible { visibility: hidden; }

/* ---------------------------------------------------------------- top */

.top {
    padding: 32px 32px 0 32px;
}

.banner {
    background-color: #ffcf40;
    border-radius: 24px;
    padding: 18px 28px;
    margin-bottom: 16px;
}

.banner-text {
    color: #222222;
    font-size: 34px;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.card {
    background-color: rgba(255, 255, 255, 0.93);
    border-radius: 32px;
    padding: 24px 32px 30px 32px;
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card-label {
    color: #0a84a8;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin: 0;
    padding: 0;
}

.card-links {
    flex-direction: row;
}

.card-text {
    color: #222222;
    font-size: 44px;
    white-space: normal;
    margin: 10px 0 0 0;
    padding: 0;
}

.progress {
    height: 10px;
    background-color: #dddddd;
    border-radius: 5px;
    margin-top: 20px;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: #0a84a8;
    border-radius: 5px;
}

/* ------------------------------------------------------------- bottom */

.bottom {
    padding: 0 32px 40px 32px;
}

.subtitles {
    margin-bottom: 20px;
}

.sub {
    background-color: rgba(0, 0, 0, 0.78);
    color: #ffffff;
    font-size: 36px;
    white-space: normal;
    padding: 14px 22px;
    border-radius: 20px;
    margin: 12px 0 0 0;
}

.sub--you { color: #ffd76a; }

.menu {
    margin-bottom: 24px;
}

.bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 170px;
}

/* ------------------------------------------------------------ buttons */
/* The default theme recolours buttons on hover/press; these rules keep our colours. */

.link,
.link:hover,
.link:hover:active {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: #0a84a8;
    font-size: 30px;
    padding: 4px 10px;
    margin: 0 0 0 14px;
}

.nav,
.nav:hover,
.nav:hover:active {
    background-color: rgba(255, 255, 255, 0.9);
    color: #222222;
    font-size: 38px;
    border-width: 0;
    border-radius: 50px;
    width: 260px;
    height: 100px;
    margin: 0;
}

.nav--primary,
.nav--primary:hover,
.nav--primary:hover:active {
    background-color: #0a84a8;
    color: #ffffff;
    -unity-font-style: bold;
}

.menu-button,
.menu-button:hover,
.menu-button:hover:active {
    background-color: rgba(255, 255, 255, 0.93);
    color: #222222;
    font-size: 42px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 50px;
    height: 120px;
    margin: 14px 0 0 0;
}

.mic,
.mic:hover,
.mic:hover:active {
    width: 160px;
    height: 160px;
    border-radius: 80px;
    background-color: #0a84a8;
    border-width: 10px;
    border-color: rgba(10, 132, 168, 0.35);
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
}

.mic--listening,
.mic--listening:hover,
.mic--listening:hover:active {
    background-color: #e5484d;
    border-color: rgba(229, 72, 77, 0.35);
}

.link:active, .nav:active, .menu-button:active, .mic:active { opacity: 0.7; }

/* Mic icon drawn from simple shapes (the default font has no emoji). */
.mic-icon { align-items: center; }

.mic-head {
    width: 36px;
    height: 56px;
    border-radius: 18px;
    background-color: #ffffff;
}

.mic-arc {
    width: 60px;
    height: 36px;
    margin-top: -22px;
    border-top-width: 0;
    border-left-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-color: #ffffff;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
}

.mic-stem {
    width: 6px;
    height: 12px;
    background-color: #ffffff;
}

.mic-base {
    width: 32px;
    height: 6px;
    border-radius: 3px;
    background-color: #ffffff;
}
