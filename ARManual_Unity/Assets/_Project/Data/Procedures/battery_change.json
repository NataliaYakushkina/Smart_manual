{
  "id": "battery_change",
  "title": "Change the battery",
  "steps": [
    {
      "text": "Place the thermometer face-down on the table.",
      "target": "FaceDown",
      "highlight": [],
      "outline": [],
      "pointAt": [],
      "hide": [],
      "animation": "",
      "xray": false
    },
    {
      "text": "Slide the battery lid straight down and off.",
      "target": "FaceDown",
      "highlight": ["BatteryLid"],
      "outline": [],
      "pointAt": [],
      "hide": [],
      "animation": "LidSlideOff",
      "xray": true
    },
    {
      "text": "Remove the old battery.",
      "target": "FaceDown",
      "highlight": ["Battery"],
      "outline": [],
      "pointAt": [],
      "hide": ["BatteryLid"],
      "animation": "BatteryLiftOut",
      "xray": false
    },
    {
      "text": "Insert a new AAA battery, + to the left.",
      "target": "FaceDown",
      "highlight": ["Battery"],
      "outline": [],
      "pointAt": ["Polarity_Plus", "Polarity_Minus"],
      "hide": ["BatteryLid"],
      "animation": "BatteryDropIn",
      "xray": false
    },
    {
      "text": "Slide the lid back on until it clicks.",
      "target": "FaceDown",
      "highlight": ["BatteryLid"],
      "outline": [],
      "pointAt": [],
      "hide": [],
      "animation": "LidSlideOn",
      "xray": false
    },
    {
      "text": "Turn the device over to see the temperature.",
      "target": "FaceUp",
      "highlight": [],
      "outline": [],
      "pointAt": ["Display_Temperature"],
      "hide": [],
      "animation": "",
      "xray": false
    }
  ]
}
